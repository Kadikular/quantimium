{
 "multipart": [
  {
   "apply": {
    "model": "quantimium:block/solar_emitter"
   }
  },
  {
   "when": {
    "output": "north|east|south|west"
   },
   "apply": {
    "model": "quantimium:block/solar_emitter_base"
   }
  },
  {
   "when": {
    "output": "down"
   },
   "apply": {
    "model": "quantimium:block/solar_emitter_base_open"
   }
  },
  {
   "when": {
    "output": "north"
   },
   "apply": {
    "model": "quantimium:block/laser_emitter_nozzle"
   }
  },
  {
   "when": {
    "output": "east"
   },
   "apply": {
    "model": "quantimium:block/laser_emitter_nozzle",
    "y": 90
   }
  },
  {
   "when": {
    "output": "south"
   },
   "apply": {
    "model": "quantimium:block/laser_emitter_nozzle",
    "y": 180
   }
  },
  {
   "when": {
    "output": "west"
   },
   "apply": {
    "model": "quantimium:block/laser_emitter_nozzle",
    "y": 270
   }
  },
  {
   "when": {
    "output": "down"
   },
   "apply": {
    "model": "quantimium:block/laser_emitter_nozzle",
    "x": 90
   }
  }
 ]
}