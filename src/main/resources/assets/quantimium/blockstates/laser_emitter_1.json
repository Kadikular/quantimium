    "south": "true",
    "lit": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_emitter_1_out_lit_south"
   }
  },
  {
   "when": {
    "south": "false"
   },
   "apply": {
    "model": "quantimium:block/laser_emitter_1_plain_south"
   }
  },
  {
   "when": {
    "west": "true",
    "lit": "false"
   },
   "apply": {
    "model": "quantimium:block/laser_emitter_1_out_west"
   }
  },
