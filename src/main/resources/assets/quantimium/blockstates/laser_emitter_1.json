    "model": "quantimium:block/laser_emitter_1_out_north"
   }
  },
  {
   "when": {
    "north": "true",
    "lit": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_emitter_1_out_lit_north"
   }
  },
  {
   "when": {
    "north": "false"
   },
   "apply": {
    "model": "quantimium:block/laser_emitter_1_plain_north"
   }
  },
  {
   "when": {
