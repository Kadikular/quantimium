  {
   "when": {
    "west": "false"
   },
   "apply": {
    "model": "quantimium:block/laser_emitter_1_plain_west"
   }
  },
  {
   "when": {
    "east": "true",
    "lit": "false"
   },
   "apply": {
    "model": "quantimium:block/laser_emitter_1_out_east"
   }
  },
  {
