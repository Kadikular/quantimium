{
 "multipart": [
  {
   "apply": {
    "model": "quantimium:block/laser_emitter_edges"
   }
  },
  {
   "when": {
    "north": "true"
   },
   "apply": {
    "model": "quantimium:block/isolator_out_north"
   }
  },
  {
   "when": {
    "north": "false"
   },
   "apply": {
    "model": "quantimium:block/isolator_plain_north"
   }
  },
  {
   "when": {
    "south": "true"
   },
   "apply": {
    "model": "quantimium:block/isolator_out_south"
   }
  },
  {
   "when": {
    "south": "false"
   },
   "apply": {
    "model": "quantimium:block/isolator_plain_south"
   }
  },
  {
   "when": {
    "west": "true"
   },
   "apply": {
    "model": "quantimium:block/isolator_out_west"
   }
  },
  {
   "when": {
    "west": "false"
   },
   "apply": {
    "model": "quantimium:block/isolator_plain_west"
   }
  },
  {
   "when": {
    "east": "true"
   },
   "apply": {
    "model": "quantimium:block/isolator_out_east"
   }
  },
  {
   "when": {
    "east": "false"
   },
   "apply": {
    "model": "quantimium:block/isolator_plain_east"
   }
  },
  {
   "when": {
    "up": "true"
   },
   "apply": {
    "model": "quantimium:block/isolator_out_up"
   }
  },
  {
   "when": {
    "up": "false",
    "facing": "east|west|up|down"
   },
   "apply": {
    "model": "quantimium:block/isolator_plain_up"
   }
  },
  {
   "when": {
    "up": "false",
    "facing": "north|south"
   },
   "apply": {
    "model": "quantimium:block/isolator_plain_up_turned"
   }
  },
  {
   "when": {
    "down": "true"
   },
   "apply": {
    "model": "quantimium:block/isolator_out_down"
   }
  },
  {
   "when": {
    "down": "false",
    "facing": "east|west|up|down"
   },
   "apply": {
    "model": "quantimium:block/isolator_plain_down"
   }
  },
  {
   "when": {
    "down": "false",
    "facing": "north|south"
   },
   "apply": {
    "model": "quantimium:block/isolator_plain_down_turned"
   }
  }
 ]
}