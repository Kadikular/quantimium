{
 "multipart": [
  {
   "apply": {
    "model": "quantimium:block/laser_emitter_edges"
   }
  },
  {
   "when": {
    "north": "true",
    "lit": "false"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_out_north"
   }
  },
  {
   "when": {
    "north": "true",
    "lit": "true"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_out_lit_north"
   }
  },
  {
   "when": {
    "facing": "south"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_in_north"
   }
  },
  {
   "when": {
    "north": "false",
    "facing": "north|east|west|up|down"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_plain_north"
   }
  },
  {
   "when": {
    "south": "true",
    "lit": "false"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_out_south"
   }
  },
  {
   "when": {
    "south": "true",
    "lit": "true"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_out_lit_south"
   }
  },
  {
   "when": {
    "facing": "north"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_in_south"
   }
  },
  {
   "when": {
    "south": "false",
    "facing": "south|east|west|up|down"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_plain_south"
   }
  },
  {
   "when": {
    "west": "true",
    "lit": "false"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_out_west"
   }
  },
  {
   "when": {
    "west": "true",
    "lit": "true"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_out_lit_west"
   }
  },
  {
   "when": {
    "facing": "east"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_in_west"
   }
  },
  {
   "when": {
    "west": "false",
    "facing": "north|south|west|up|down"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_plain_west"
   }
  },
  {
   "when": {
    "east": "true",
    "lit": "false"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_out_east"
   }
  },
  {
   "when": {
    "east": "true",
    "lit": "true"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_out_lit_east"
   }
  },
  {
   "when": {
    "facing": "west"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_in_east"
   }
  },
  {
   "when": {
    "east": "false",
    "facing": "north|south|east|up|down"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_plain_east"
   }
  },
  {
   "when": {
    "up": "true",
    "lit": "false"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_out_up"
   }
  },
  {
   "when": {
    "up": "true",
    "lit": "true"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_out_lit_up"
   }
  },
  {
   "when": {
    "facing": "down"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_in_up"
   }
  },
  {
   "when": {
    "up": "false",
    "facing": "east|west|up"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_plain_up"
   }
  },
  {
   "when": {
    "up": "false",
    "facing": "north|south"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_plain_up_turned"
   }
  },
  {
   "when": {
    "down": "true",
    "lit": "false"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_out_down"
   }
  },
  {
   "when": {
    "down": "true",
    "lit": "true"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_out_lit_down"
   }
  },
  {
   "when": {
    "facing": "up"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_in_down"
   }
  },
  {
   "when": {
    "down": "false",
    "facing": "east|west|down"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_plain_down"
   }
  },
  {
   "when": {
    "down": "false",
    "facing": "north|south"
   },
   "apply": {
    "model": "quantimium:block/logistics_controller_plain_down_turned"
   }
  }
 ]
}