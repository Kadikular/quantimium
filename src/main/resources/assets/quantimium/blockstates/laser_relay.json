{
 "multipart": [
  {
   "when": {
    "mount": "down"
   },
   "apply": {
    "model": "quantimium:block/laser_relay"
   }
  },
  {
   "when": {
    "mount": "up"
   },
   "apply": {
    "model": "quantimium:block/laser_relay",
    "x": 180
   }
  },
  {
   "when": {
    "mount": "south"
   },
   "apply": {
    "model": "quantimium:block/laser_relay",
    "x": 90
   }
  },
  {
   "when": {
    "mount": "west"
   },
   "apply": {
    "model": "quantimium:block/laser_relay",
    "x": 90,
    "y": 90
   }
  },
  {
   "when": {
    "mount": "north"
   },
   "apply": {
    "model": "quantimium:block/laser_relay",
    "x": 90,
    "y": 180
   }
  },
  {
   "when": {
    "mount": "east"
   },
   "apply": {
    "model": "quantimium:block/laser_relay",
    "x": 90,
    "y": 270
   }
  },
  {
   "when": {
    "north": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_relay_emitter_north"
   }
  },
  {
   "when": {
    "east": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_relay_emitter_east",
    "y": 90
   }
  },
  {
   "when": {
    "south": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_relay_emitter_south",
    "y": 180
   }
  },
  {
   "when": {
    "west": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_relay_emitter_west",
    "y": 270
   }
  },
  {
   "when": {
    "up": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_relay_emitter_up",
    "x": 270
   }
  },
  {
   "when": {
    "down": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_relay_emitter_down",
    "x": 90
   }
  }
 ]
}