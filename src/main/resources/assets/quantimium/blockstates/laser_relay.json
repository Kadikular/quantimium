{
 "multipart": [
  {
   "apply": {
    "model": "quantimium:block/laser_relay"
   }
  },
  {
   "when": {
    "north": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_relay_out_north"
   }
  },
  {
   "when": {
    "south": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_relay_out_south"
   }
  },
  {
   "when": {
    "west": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_relay_out_west"
   }
  },
  {
   "when": {
    "east": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_relay_out_east"
   }
  },
  {
   "when": {
    "down": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_relay_out_down"
   }
  },
  {
   "when": {
    "up": "true"
   },
   "apply": {
    "model": "quantimium:block/laser_relay_out_up"
   }
  }
 ]
}