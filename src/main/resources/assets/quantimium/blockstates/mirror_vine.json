{
  "multipart": [
    {
      "when": { "north": "true" },
      "apply": { "model": "quantimium:block/mirror_vine" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "quantimium:block/mirror_vine", "uvlock": true, "y": 90 }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "quantimium:block/mirror_vine", "uvlock": true, "y": 180 }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "quantimium:block/mirror_vine", "uvlock": true, "y": 270 }
    }
  ]
}
